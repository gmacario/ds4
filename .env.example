# Copy to .env and adjust. Docker Compose loads .env automatically.

# --- Common runtime settings ---------------------------------------------

# Model downloaded by download_model.sh on container startup. Must be one of
# its supported targets: q2-imatrix, q2-q4-imatrix, q4-imatrix,
# pro-q2-imatrix, glm-unsloth-q4, glm-antirez-q2, glm-antirez-iq2xxs,
# glm-antirez-q4, or "none" to skip the download (then set DS4_MODEL_PATH or
# mount a pre-named ./gguf/ds4flash.gguf yourself).
DS4_MODEL=q2-imatrix

# Context size passed to ds4-server --ctx.
DS4_CTX=32768

# Host port published to the container's fixed internal port 8000.
DS4_PORT=8000

# Enable MTP speculative decoding. Set to 1 to download the MTP GGUF and pass
# --mtp/--mtp-draft to ds4-server. Only compatible with the Flash q2/q4
# imatrix quants above.
DS4_ENABLE_MTP=0
DS4_MTP_DRAFT=2
DS4_MTP_MARGIN=

# Disk KV cache budget passed to ds4-server --kv-disk-space-mb. The cache
# directory itself is fixed to /kv-cache inside the container (see the
# DS4_KV_HOST_DIR mount below).
DS4_KV_DISK_SPACE_MB=8192

# Explicit -m/--model override, e.g. /models/my-custom.gguf. Leave empty to
# use the ./ds4flash.gguf symlink download_model.sh creates.
DS4_MODEL_PATH=

# CPU helper threads passed to ds4-server --threads, if set.
DS4_THREADS=

# Extra ds4-server flags appended to the generated command, e.g.
# "--quality --cuda-tensor-parallel".
DS4_EXTRA_ARGS=

# Optional Hugging Face token, needed for the larger PRO/GLM model downloads.
HF_TOKEN=

# --- Host directories -------------------------------------------------------

# Host directory mounted at /models. Matches download_model.sh's own default
# so models fetched on the host under ./gguf are reused by the container.
DS4_WEIGHTS_HOST_DIR=./gguf

# Host directory mounted at /kv-cache for disk KV checkpoints.
DS4_KV_HOST_DIR=./kv-cache

# --- Build settings ----------------------------------------------------------

# nvcc -arch value. See the table in Dockerfile / CONTAINER.md. Leave empty
# for the DGX Spark / GB10 path (mirrors `make cuda-spark`).
CUDA_ARCH=sm_90
